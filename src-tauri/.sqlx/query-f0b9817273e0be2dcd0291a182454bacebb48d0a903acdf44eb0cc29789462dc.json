  "query": "\n            SELECT id as \"id!\", task_id as \"task_id!\", start_time as \"start_time!\", end_time, notes, created_at as \"created_at!\"\n            FROM time_entries\n            WHERE task_id = ?\n              AND start_time >= ?\n              AND start_time <  ?\n              AND end_time IS NOT NULL\n            ORDER BY start_time DESC\n            ",
